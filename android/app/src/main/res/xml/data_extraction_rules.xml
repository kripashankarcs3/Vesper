<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ : exclude ALL app data from cloud backup AND device-to-device
     transfer. The vault (encrypted messages DB, Keystore-backed key, and the
     plaintext media copies) must never leave the device through any backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
